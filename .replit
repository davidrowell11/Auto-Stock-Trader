# Replit setup for the trading bot server (engine/). The Flutter app is not run here.
# Kept identical to the Replit app's own copy so pulls from GitHub don't conflict.
modules = ["python-3.12"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 8000
externalPort = 80

# Reserved VM ("vm") stays on all the time. Autoscale would sleep and miss trades.
[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "cd engine && python -m autotrader.server"]
build = ["sh", "-c", "python -m pip install -r engine/requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd engine && PORT=8000 python -m autotrader.server"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"
